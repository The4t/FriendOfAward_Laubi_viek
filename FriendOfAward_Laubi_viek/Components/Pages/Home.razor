 @page "/home"
@using System.Data
<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Friends of Award</title>
    <script src="https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js"></script>
    <style>
        body {
            margin: 0;
            font-family: sans-serif;
            background-color: #f0f0f0;
            color: #333;
            transition: background-color 0.3s, color 0.3s;
        }

        .dark-mode {
            background-color: #222;
            color: #eee;
        }

        h1 {
            text-align: center;
            margin-top: 1rem;
        }

        .legend-box {
            text-align: center;
            margin: 0.5rem 1rem 1rem;
        }

            .legend-box p {
                margin: 0.4rem 0;
                font-weight: bold;
            }

            .legend-box .small-note {
                font-size: 0.9rem;
                font-weight: normal;
                margin-top: 0.6rem;
            }

        .button-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 10px;
            max-width: 800px;
            margin: auto;
        }

        .diplom-btn {
            padding: 1rem;
            font-size: 1rem;
            border: none;
            border-radius: 8px;
            background: #e0e0e0;
            cursor: pointer;
        }

        .button {
            padding: 1rem;
            font-size: 1.2rem;
            border: none;
            border-radius: 8px;
            cursor: pointer;
            background: #e0e0e0;
            transition: transform 0.2s, background 0.3s;
        }

            .button:active {
                transform: scale(0.95);
            }

        .favorit {
            background-color: #4CAF50;
            color: white;
            position: relative;
        }

            .favorit::after {
                content: "⭐";
                position: absolute;
                top: 5px;
                right: 10px;
            }

        .topfavorit {
            background-color: orange;
            color: white;
            position: relative;
        }

            .topfavorit::after {
                content: "⭐⭐";
                position: absolute;
                top: 5px;
                right: 10px;
            }

        #info {
            text-align: center;
            margin: 1rem;
            font-weight: bold;
        }

        #message {
            text-align: center;
            font-weight: bold;
        }

        #submitBtn {
            display: block;
            margin: 1rem auto;
            padding: 1rem 2rem;
            font-size: 1.2rem;
            background-color: #2196F3;
            color: white;
            border: none;
            border-radius: 12px;
            transition: background 0.3s;
        }

            #submitBtn:hover:not(:disabled) {
                background-color: #1976D2;
            }

            #submitBtn:disabled {
                background-color: #90CAF9;
                cursor: not-allowed;
            }

        #adminToggle {
            position: fixed;
            bottom: 10px;
            right: 10px;
            font-size: 24px;
            cursor: pointer;
        }

        #adminPanel {
            display: none;
            background: white;
            padding: 1rem;
            margin: 1rem;
            border: 1px solid #ccc;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin: 1rem 0;
        }

        th, td {
            border: 1px solid #ccc;
            padding: 0.5rem;
            text-align: center;
        }

        .diplom-table {
            width: 80%;
            margin: 2rem auto;
            border-collapse: collapse;
            font-family: sans-serif;
            background: #ffffff;
            border-radius: 8px;
            overflow: hidden;
            box-shadow: 0 2px 8px rgba(0,0,0,0.08);
        }

            .diplom-table thead {
                background: #e8f2ff; /* sehr leichtes Blau */
            }

            .diplom-table th {
                padding: 0.75rem;
                text-align: left;
                font-weight: bold;
                color: #2a4d7a;
                border-bottom: 2px solid #c9ddff;
            }

            .diplom-table td {
                padding: 0.7rem;
                border-bottom: 1px solid #e3e9f2;
            }

            .diplom-table tr:nth-child(even) {
                background: #f7faff; /* ganz leichtes Blau für Zebra-Effekt */
            }

            .diplom-table tr:hover {
                background: #e6f0ff; /* dezentes Hover-Blau */
                transition: background 0.2s ease-in-out;
            }

    </style>

</head>
<body>
     <h1>Friends of Award</h1>
        <div class="legend-box">
        <p>Geben Sie uns Ihre persönlichen Favoriten bekannt!</p>
        <p>
            Einfacher Klick = Favorit (max. 5)<br />
            Doppelklick = Topfavorit (max. 1)
        </p>
        <p class="small-note">Diese Abstimmung ist anonym und auf ein Gerät beschränkt.</p>
    </div>

    <div class="button-grid">
        @foreach (var item in diplomarbeiten)
        {
            <button class="button"
                    data-id="@item.Id"
                    onclick="handleClick(@item.Id, this)"
                    ondblclick="toggleTopFavorit(@item.Id, this)">
                @item.Id
            </button>

        }
    </div>
    <table class="diplom-table">
        <thead>
            <tr>
                <th>Nr.</th>
                <th>Titel</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in diplomarbeiten)
            {
                <tr>
                    <td>@item.Id</td>
                    <td>@item.Titel</td>
                </tr>
            }
        </tbody>
    </table>
    <div id="info"></div>
    <div id="message"></div>
    <button id="submitBtn" disabled>Bewertung absenden</button>

    <div id="adminToggle">🏠</div>

    <div id="adminPanel">
        <h2>Adminbereich</h2>
        <div>
            <label>Admin-Code:</label>
            <input type="password" id="adminCode" />
            <button onclick="checkAdmin()">Anmelden</button>
            <button onclick="logoutAdmin()">Abmelden</button>
        </div>
        <div id="adminControls" style="display:none;">
            <button onclick="startVoting()">Abstimmung starten</button>
            <button onclick="stopVoting()">Abstimmung stoppen</button>
            <button onclick="resetVotes()">Alle Bewertungen löschen</button>
            <button onclick="clearLocalVote()">Neue Abstimmung auf diesem Gerät erlauben</button>
            <button onclick="changePassword()">Passwort ändern</button>
            <button onclick="exportExcel()">Excel exportieren</button>
            <div id="adminStatus" style="margin-top:10px; color:blue;"></div>
            <table id="summaryTable">
                <thead>
                    <tr>
                        <th>Arbeit</th>
                        <th>Anzahl Nennung Favorit</th>
                        <th>Anzahl Nennung Topfavorit</th>
                        <th>Punkte</th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>
    </div> 

    

    <div id="info"></div>
    <div id="message"></div>


        @code {
                public class Diplomarbeit
                {
                        public int Id { get; set; }
                        public string Titel { get; set; }
                }

                List<Diplomarbeit> diplomarbeiten = new();

                protected override void OnInitialized()
                {
                        LoadDiplomarbeiten();
                }

                private void LoadDiplomarbeiten()
                {
                        var db = DbWrapperMySqlV2.Wrapper;
                        var table = db.RunQuery("SELECT id, titel FROM diplomarbeiten ORDER BY id");

                        diplomarbeiten = table.AsEnumerable()
                                .Select(row => new Diplomarbeit
                                {
                                        Id = Convert.ToInt32(row["id"]),
                                        Titel = row["titel"].ToString()!
                                })
                                .ToList();
                }
        }
   
</body>
</html>