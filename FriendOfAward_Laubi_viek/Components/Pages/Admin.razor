@page "/admin"
@inject NavigationManager Nav
@rendermode InteractiveServer

<div class="choice-wrapper">
    <div class="choice-card">
        <h2>Willkommen, Admin</h2>
        <p>Was möchtest du als Nächstes tun?</p>

        <button class="choice-btn" @onclick="GoToQr">QR‑Code generieren</button>
        <button class="choice-btn secondary" @onclick="GoToDashboard">Zum Admin‑Dashboard</button>
    </div>
</div>

@code {
    void GoToQr() => Nav.NavigateTo("/generateqr");
    void GoToDashboard() => Nav.NavigateTo("/admindashboard");
}

<style>
    .choice-wrapper {
        display: flex;
        justify-content: center;
        margin-top: 60px;
    }

    .choice-card {
        background: #ffffff;
        padding: 30px;
        width: 420px;
        border-radius: 14px;
        box-shadow: 0 4px 18px rgba(0,0,0,0.12);
        text-align: center;
    }

    .choice-btn {
        width: 100%;
        padding: 12px;
        background: #4a6cf7;
        color: white;
        border: none;
        border-radius: 8px;
        font-size: 16px;
        cursor: pointer;
        margin-top: 10px;
        transition: 0.2s;
    }

        .choice-btn.secondary {
            background: #555;
        }

        .choice-btn:hover {
            background: #3a58d8;
        }
</style>
