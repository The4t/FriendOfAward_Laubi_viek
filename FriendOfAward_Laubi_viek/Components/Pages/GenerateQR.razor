@page "/generateqr"
@inject QrServiceToken QrService
@inject NavigationManager Nav
@rendermode InteractiveServer

<div class="topbar">
    <button class="back-btn" @onclick="GoHome">← Zurück zum Dashboard</button>
</div>

<div class="qr-wrapper">
    <div class="qr-card">

        <h2>QR‑Code Generator</h2>
        <p class="subtitle">Erstelle einen einmaligen QR‑Code für den Scan‑Zugang.</p>

        @if (QrCode == null)
        {
            <button class="qr-btn" @onclick="GenerateQr">QR‑Code erstellen</button>
        }
        else
        {
            <button class="qr-btn" @onclick="GenerateQr">Neuen QR‑Code erstellen</button>

            <div class="qr-image-box">
                <img src="data:image/png;base64,@QrCode" />
            </div>
        }
    </div>
</div>

@code {
    string? QrCode;

    private void GenerateQr()
    {
        string token = QrService.CreateAndStoreToken();
        QrCode = QrService.GenerateQrBase64(token);
    }

    void GoHome() => Nav.NavigateTo("/admindashboard");
}

<style>
    /* Topbar */
    .topbar {
        width: 100%;
        padding: 15px 25px;
        background: #f7f7f7;
        border-bottom: 1px solid #ddd;
        position: fixed;
        top: 0;
        left: 0;
        z-index: 10;
    }

    .back-btn {
        background: #555;
        color: white;
        border: none;
        padding: 8px 16px;
        border-radius: 6px;
        cursor: pointer;
        font-size: 14px;
        transition: 0.2s;
    }

        .back-btn:hover {
            background: #333;
        }

    /* Layout */
    .qr-wrapper {
        display: flex;
        justify-content: center;
        margin-top: 120px;
    }

    .qr-card {
        background: #ffffff;
        padding: 30px;
        width: 420px;
        border-radius: 14px;
        box-shadow: 0 4px 18px rgba(0,0,0,0.12);
        text-align: center;
    }

    h2 {
        margin-bottom: 10px;
        font-weight: 600;
    }

    .subtitle {
        color: #666;
        margin-bottom: 25px;
        font-size: 14px;
    }

    .qr-btn {
        width: 100%;
        padding: 12px;
        background: #4a6cf7;
        color: white;
        border: none;
        border-radius: 8px;
        font-size: 16px;
        cursor: pointer;
        transition: 0.2s;
        margin-bottom: 20px;
    }

        .qr-btn:hover {
            background: #3a58d8;
        }

    .qr-image-box {
        margin-top: 20px;
        padding: 20px;
        background: #fafafa;
        border-radius: 12px;
        border: 1px solid #eee;
    }

        .qr-image-box img {
            width: 220px;
            height: 220px;
        }
</style>
