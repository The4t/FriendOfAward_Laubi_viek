@page "/"
@inject NavigationManager Nav 
@inject AuthServiceSimple Auth
@rendermode InteractiveServer


<div class="login-wrapper">
    <div class="login-card">
        <h2>Admin Login</h2>

        <div class="input-group">
            <label>E-Mail</label>
            <input @bind="Email" class="input-field" type="email" placeholder="E-Mail eingeben" />
        </div>
        <br />
        <br>
        <div class="input-group">
            <label>Passwort</label>
            <input @bind="Password" class="input-field" type="password" placeholder="Passwort eingeben" />
        </div>
        <br />



        <button class="login-button" @onclick="Btn_DoLogin">  Login</button>



        @if (!string.IsNullOrEmpty(ErrorMessage))
        {
            <p class="error-text">@ErrorMessage</p>
        }
    </div>
</div>


@code {
    string Email = "";
    string Password = "";
    string ErrorMessage = "";



    private void Btn_DoLogin()
    {
        Console.WriteLine("Login-Button gedrückt!"); 

        bool result = Auth.ValidateLogin(Email, Password);

        if (result)
        {
            Console.WriteLine("Login erfolgreich!"); 
            Nav.NavigateTo("/showqr");
        }
        else
        {
            Console.WriteLine("Login fehlgeschlagen!"); 
            ErrorMessage = "E-Mail oder Passwort ist falsch.";
        }
    }

}





